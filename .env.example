# Better Auth secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
# Set in Cloudflare Pages → Settings → Variables and Secrets (encrypted).
BETTER_AUTH_SECRET=your-32-byte-secret

# AWS SES — outbound magic-link email. https://aws.amazon.com/ses
# IAM user with ses:SendEmail permissions; verified sending domain.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
EMAIL_FROM="Americans for Propriety <hello@americansforpropriety.org>"

# Anthropic — used by the letter generator and the AI brief drafter.
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Geocodio — ZIP/address → state, district, federal+state legislators
# https://www.geocod.io
GEOCODIO_API_KEY=your-geocodio-key

# Used for absolute URLs in magic-link emails and OG tags.
PUBLIC_SITE_URL=http://localhost:4321

# Comma-separated list of admin emails (have access to /admin/*).
ADMIN_EMAILS=you@example.com

# NOTE on D1: the database binding is configured in wrangler.toml
# (the [[d1_databases]] block) and in the Cloudflare Pages dashboard
# under Settings → Bindings. There is no env var for it.
