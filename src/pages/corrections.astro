---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";

interface Correction {
  date: string;
  page: string;
  href?: string;
  summary: string;
  type: "correction" | "clarification" | "update";
}

// Append to the top. Keep entries terse — link to the affected page for context.
const corrections: Correction[] = [];
---
<BaseLayout
  title="Corrections"
  description="How we handle errors, and a public log of what we've fixed."
>
  <section class="border-b border-rule bg-paper">
    <div class="container-page py-20 md:py-28">
      <p class="eyebrow">Corrections</p>
      <h1 class="mt-3 max-w-4xl text-balance">
        We log every correction. Quietly editing a mistake is its own kind of mistake.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        This page is the public record of every correction, clarification, and substantive update made to a brief, letter, or news post on this site after publication. Read it; hold us to it.
      </p>
    </div>
  </section>

  <Section eyebrow="Policy" title="What we fix, and how">
    <div class="prose-editorial">
      <p>
        A <strong>correction</strong> is the fix to a factual error: a wrong figure, a misstated bill number, a misattributed quote, an inaccurate description of a court ruling. We update the affected page, add a dated note at the top, and add an entry to the log below.
      </p>
      <p>
        A <strong>clarification</strong> is a change to wording that was technically accurate but misleading. Same treatment: noted on the page, logged here.
      </p>
      <p>
        An <strong>update</strong> is a substantive revision after a development changes the underlying facts — a bill advances, a court rules, an agency finalizes a regulation. The date of the update is noted at the top of the piece.
      </p>
      <p>
        We do not silently edit a published piece. Typo fixes, broken-link repairs, and formatting tweaks are not logged.
      </p>
    </div>
  </Section>

  <Section eyebrow="Submit" title="Spot something wrong" tone="warm">
    <div class="prose-editorial">
      <p>
        Email <a href="mailto:corrections@americansforpropriety.org">corrections@americansforpropriety.org</a> with:
      </p>
      <ul>
        <li>the URL of the affected page;</li>
        <li>the specific claim or quote you believe is wrong;</li>
        <li>a source that supports your version, if you have one.</li>
      </ul>
      <p>
        We will respond within five business days. If we agree, we'll fix the page, log it here, and reply to tell you the entry is up.
      </p>
    </div>
  </Section>

  <Section eyebrow="Log" title="What we've fixed">
    {corrections.length === 0 ? (
      <p class="text-ink-muted">
        No corrections issued yet. This site has been live since May 2026 — the longer it runs, the more this section will fill out.
      </p>
    ) : (
      <ol class="space-y-6">
        {corrections.map((c) => (
          <li class="grid gap-3 border-t border-rule pt-5 md:grid-cols-12">
            <div class="md:col-span-3">
              <time class="font-mono text-sm text-ink-muted">{c.date}</time>
              <p class="mt-1 text-xs uppercase tracking-wider text-coral-deep">{c.type}</p>
            </div>
            <div class="md:col-span-9">
              <p class="font-semibold">
                {c.href ? <a href={c.href} class="no-underline hover:underline">{c.page}</a> : c.page}
              </p>
              <p class="mt-1 text-ink-soft">{c.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </Section>
</BaseLayout>
