---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import PostCard from "~/components/PostCard.astro";
import ActionBanner from "~/components/ActionBanner.astro";

export async function getStaticPaths() {
  const issues = await getCollection("issues");
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);

const briefs = (await getCollection("briefs", ({ data }) => !data.draft && data.issue === issue.id))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const letters = (await getCollection("letters", ({ data }) => data.issue === issue.id))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());

const actions = await getCollection("actions", ({ data }) => data.issue === issue.id);

const accentVar = {
  coral: "var(--color-coral)",
  gold: "var(--color-gold)",
  leaf: "var(--color-leaf)",
  ink: "var(--color-ink)",
}[issue.data.accent];
---
<BaseLayout title={issue.data.title} description={issue.data.summary} ogType="article">
  <article>
    <header class="border-b border-rule bg-paper">
      <div class="container-page py-16 md:py-24">
        <span class="block h-1 w-16" style={`background:${accentVar}`}></span>
        <p class="eyebrow mt-5">{issue.data.eyebrow}</p>
        <h1 class="mt-3 max-w-4xl text-balance">{issue.data.headline}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-soft md:text-xl">
          {issue.data.stance}
        </p>
      </div>
    </header>

    {issue.data.pillars.length > 0 && (
      <Section eyebrow="Pillars" title="Where we plant our flag">
        <div class="grid gap-6 md:grid-cols-3">
          {issue.data.pillars.map((p) => (
            <div class="border-t-2 pt-5" style={`border-color:${accentVar}`}>
              <h3 class="font-display text-xl font-semibold">{p.title}</h3>
              <p class="mt-3 text-ink-muted">{p.body}</p>
            </div>
          ))}
        </div>
      </Section>
    )}

    {issue.data.facts.length > 0 && (
      <Section eyebrow="Facts on file" title="What's actually true" tone="warm">
        <ul class="grid gap-4 md:grid-cols-2">
          {issue.data.facts.map((fact) => (
            <li class="border-l-2 pl-4 text-base leading-relaxed text-ink-soft" style={`border-color:${accentVar}`}>
              {fact}
            </li>
          ))}
        </ul>
      </Section>
    )}

    <Section eyebrow="In context" title="Read the issue">
      <div class="prose-editorial">
        <Content />
      </div>
    </Section>

    {issue.data.subtopics.length > 0 && (
      <Section eyebrow="Sub-topics" title="The conversation, broken down" tone="warm">
        <div class="space-y-12">
          {issue.data.subtopics.map((s) => (
            <article id={s.slug} class="grid gap-6 md:grid-cols-12">
              <div class="md:col-span-4">
                <span class="block h-1 w-10" style={`background:${accentVar}`}></span>
                <h3 class="mt-3 font-display text-xl font-semibold">{s.title}</h3>
                <p class="mt-2 text-ink-muted">{s.summary}</p>
              </div>
              <div class="md:col-span-8 prose-editorial max-w-none!">
                <p>{s.body}</p>
              </div>
            </article>
          ))}
        </div>
      </Section>
    )}

    {issue.data.keyBills.length > 0 && (
      <Section eyebrow="Legislation" title="Key bills to watch">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b-2" style={`border-color:${accentVar}`}>
              <th class="py-3 pr-4 font-semibold">Bill</th>
              <th class="py-3 pr-4 font-semibold">What it does</th>
              <th class="py-3 pr-4 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody>
            {issue.data.keyBills.map((b) => (
              <tr class="border-b border-rule align-top">
                <td class="py-3 pr-4">
                  <span class="font-semibold">{b.name}</span>
                  <span class="block text-xs uppercase tracking-wider text-ink-muted">
                    {b.chamber}
                  </span>
                </td>
                <td class="py-3 pr-4 text-ink-soft">{b.summary}</td>
                <td class="py-3 pr-4 text-ink-muted">{b.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </Section>
    )}

    {issue.data.whoAffected && (
      <Section eyebrow="Who's affected" title="Who carries the cost, who reaps the benefit" tone="warm">
        <div class="prose-editorial">
          {issue.data.whoAffected.split("\n\n").map((p) => <p>{p}</p>)}
        </div>
      </Section>
    )}

    {issue.data.timeline.length > 0 && (
      <Section eyebrow="Timeline" title="How we got here">
        <ol class="space-y-4">
          {issue.data.timeline.map((t) => (
            <li class="grid gap-3 border-l-2 pl-5 md:grid-cols-12" style={`border-color:${accentVar}`}>
              <time class="md:col-span-2 font-mono text-sm text-ink-muted">{t.date}</time>
              <span class="md:col-span-10 text-ink-soft">{t.event}</span>
            </li>
          ))}
        </ol>
      </Section>
    )}

    {issue.data.glossary.length > 0 && (
      <Section eyebrow="Glossary" title="Plain-language definitions" tone="warm">
        <dl class="grid gap-6 md:grid-cols-2">
          {issue.data.glossary.map((g) => (
            <div>
              <dt class="font-display text-lg font-semibold">{g.term}</dt>
              <dd class="mt-1 text-ink-soft">{g.definition}</dd>
            </div>
          ))}
        </dl>
      </Section>
    )}

    {briefs.length > 0 && (
      <Section eyebrow="Research" title="Briefs on this issue" tone="warm">
        {briefs.map((b) => (
          <PostCard
            href={`/briefs/${b.id}`}
            eyebrow="Brief"
            title={b.data.title}
            summary={b.data.summary}
            date={b.data.publishedAt}
          />
        ))}
      </Section>
    )}

    {(letters.length > 0 || actions.length > 0) && (
      <Section eyebrow="Engage" title="What you can do">
        <div class="grid gap-8 md:grid-cols-2">
          {letters.length > 0 && (
            <div>
              <p class="eyebrow">Letters</p>
              <ul class="mt-3 space-y-3">
                {letters.map((l) => (
                  <li>
                    <a href={`/letters/${l.id}`} class="block border-t border-rule py-3 no-underline">
                      <span class="font-semibold">{l.data.title}</span>
                      <span class="block text-sm text-ink-muted">{l.data.summary}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {actions.length > 0 && (
            <div>
              <p class="eyebrow">Actions</p>
              <ul class="mt-3 space-y-3">
                {actions.map((a) => (
                  <li class="border-t border-rule py-3">
                    <span class="font-semibold">{a.data.title}</span>
                    <span class="block text-sm text-ink-muted">{a.data.summary}</span>
                    <a href={a.data.href} class="mt-2 inline-block text-sm font-semibold text-coral-deep no-underline hover:underline">
                      {a.data.cta} →
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </Section>
    )}
  </article>

  <ActionBanner />
</BaseLayout>
