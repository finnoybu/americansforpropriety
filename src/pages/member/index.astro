---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MemberNav from "~/components/MemberNav.astro";
import { getDb } from "~/db";
import { actionLog, generatedLetter } from "~/db/schema";
import { eq, desc } from "drizzle-orm";

export const prerender = false;

if (!Astro.locals.user) {
  return Astro.redirect("/signin?next=/member");
}

const profile = Astro.locals.profile;
const needsSetup = !profile?.zip;

const db = getDb(Astro);

const recentActions = await db
  .select({
    id: actionLog.id,
    actionType: actionLog.actionType,
    topic: actionLog.topic,
    representativeName: actionLog.representativeName,
    occurredAt: actionLog.occurredAt,
  })
  .from(actionLog)
  .where(eq(actionLog.userId, Astro.locals.user.id))
  .orderBy(desc(actionLog.occurredAt))
  .limit(5);

const recentLetters = await db
  .select({
    id: generatedLetter.id,
    representativeName: generatedLetter.representativeName,
    topic: generatedLetter.topic,
    createdAt: generatedLetter.createdAt,
  })
  .from(generatedLetter)
  .where(eq(generatedLetter.userId, Astro.locals.user.id))
  .orderBy(desc(generatedLetter.createdAt))
  .limit(5);

// We don't carry representativesCache through middleware (kept off the
// Astro.locals.profile shape to keep that small). Look it up here only when
// rendering the dashboard summary.
let repCount = 0;
if (profile?.userId) {
  const { profile: profileTable } = await import("~/db/schema");
  const [row] = await db
    .select({ cache: profileTable.representativesCache })
    .from(profileTable)
    .where(eq(profileTable.userId, profile.userId))
    .limit(1);
  if (Array.isArray(row?.cache)) repCount = row.cache.length;
}
---
<BaseLayout title="Member dashboard">
  <section class="container-page py-12 md:py-16">
    <p class="eyebrow">Member</p>
    <h1 class="mt-2">Welcome back.</h1>
    <p class="mt-3 text-ink-muted">{Astro.locals.user.email}</p>

    <MemberNav />

    {needsSetup && (
      <div class="mb-10 border-l-4 border-coral bg-paper-warm p-5">
        <p class="font-semibold">Finish setting up your account.</p>
        <p class="mt-1 text-sm text-ink-muted">
          We need your ZIP to find your representatives. We don't store a full address.
        </p>
        <a href="/member/setup" class="btn btn-primary mt-4">Add your ZIP <span aria-hidden>→</span></a>
      </div>
    )}

    <div class="grid gap-10 md:grid-cols-2">
      <section>
        <h2 class="text-xl">Locale</h2>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">ZIP</dt>
            <dd>{profile?.zip ?? <em class="text-ink-muted">not set</em>}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">State</dt>
            <dd>{profile?.state ?? "—"}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">Congressional district</dt>
            <dd>{profile?.congressionalDistrict ?? "—"}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">Representatives on file</dt>
            <dd>{repCount}</dd>
          </div>
        </dl>
        <a href="/member/setup" class="mt-4 inline-block text-sm font-semibold underline">Update locale</a>
      </section>

      <section>
        <h2 class="text-xl">Quick actions</h2>
        <ul class="mt-4 space-y-3">
          <li>
            <a href="/member/write" class="block border-t border-rule py-3 no-underline">
              <span class="font-semibold">Draft a letter</span>
              <span class="block text-sm text-ink-muted">Generate a personalized draft for one of your representatives.</span>
            </a>
          </li>
          <li>
            <a href="/member/representatives" class="block border-t border-rule py-3 no-underline">
              <span class="font-semibold">See my representatives</span>
              <span class="block text-sm text-ink-muted">Names, offices, and how to contact each one.</span>
            </a>
          </li>
          <li>
            <a href="/take-action" class="block border-t border-rule py-3 no-underline">
              <span class="font-semibold">Browse current asks</span>
              <span class="block text-sm text-ink-muted">Curated calls, testimony submissions, and templates.</span>
            </a>
          </li>
        </ul>
      </section>
    </div>

    <section class="mt-16">
      <h2 class="text-xl">Recent activity</h2>
      {recentActions.length === 0 && recentLetters.length === 0 && (
        <p class="mt-4 text-sm text-ink-muted">
          No activity yet. Drafting a letter or logging an action will surface here.
        </p>
      )}
      {recentLetters.length > 0 && (
        <div class="mt-6">
          <p class="eyebrow">Recent drafts</p>
          <ul class="mt-3 space-y-2">
            {recentLetters.map((l) => (
              <li class="flex items-baseline justify-between gap-4 border-t border-rule py-2 text-sm">
                <span>
                  <strong>{l.representativeName}</strong>
                  <span class="text-ink-muted"> · {l.topic}</span>
                </span>
                <time class="text-xs text-ink-muted">
                  {l.createdAt?.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                </time>
              </li>
            ))}
          </ul>
        </div>
      )}
      {recentActions.length > 0 && (
        <div class="mt-8">
          <p class="eyebrow">Recent actions</p>
          <ul class="mt-3 space-y-2">
            {recentActions.map((a) => (
              <li class="flex items-baseline justify-between gap-4 border-t border-rule py-2 text-sm">
                <span>
                  <strong>{a.actionType.replace(/_/g, " ")}</strong>
                  {a.topic && <span class="text-ink-muted"> · {a.topic}</span>}
                  {a.representativeName && (
                    <span class="text-ink-muted"> · {a.representativeName}</span>
                  )}
                </span>
                <time class="text-xs text-ink-muted">
                  {a.occurredAt?.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                </time>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </section>
</BaseLayout>
