---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MemberNav from "~/components/MemberNav.astro";
import { getEnv } from "~/lib/env";

export const prerender = false;

if (!Astro.locals.user) return Astro.redirect("/signin?next=/member/setup");

const profile = Astro.locals.profile;

// Representative lookup depends on the Geocodio API key. Until it's set,
// surface a calm notice rather than letting members submit into a failure.
const geocodioReady = Boolean(getEnv(Astro).GEOCODIO_API_KEY);
---
<BaseLayout title="Set up your account">
  <section class="container-page max-w-3xl py-12 md:py-16">
    <p class="eyebrow">Member · Settings</p>
    <h1 class="mt-2">Locale & preferences</h1>
    <MemberNav />

    <div class="grid gap-10 md:grid-cols-2">
      <section>
        <h2 class="text-xl">Your ZIP</h2>
        <p class="mt-2 text-sm text-ink-muted">
          We use this to find your federal and state representatives. We store the ZIP, your state, and your district numbers — not your full address.
        </p>

        {!geocodioReady && (
          <p class="mt-4 border-l-2 border-coral bg-paper-warm p-3 text-sm leading-relaxed">
            Representative lookup is still being set up and isn't available yet.
            Your account works fine in the meantime — check back soon to add your ZIP.
          </p>
        )}

        <form id="zip-form" class="mt-6 space-y-3">
          <label class="block">
            <span class="eyebrow">ZIP code</span>
            <input
              required
              name="zip"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              disabled={!geocodioReady}
              class="mt-2 w-40 border border-rule bg-paper px-3 py-2 font-mono text-lg focus:border-ink focus:outline-none disabled:opacity-50"
              value={profile?.zip ?? ""}
              placeholder="10001"
            />
          </label>
          <button class="btn btn-ink disabled:opacity-50" type="submit" disabled={!geocodioReady}>Save & look up reps</button>
          <p id="zip-status" class="text-sm"></p>
        </form>
      </section>

      <section>
        <h2 class="text-xl">Account</h2>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">Email</dt>
            <dd>{Astro.locals.user.email}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">State</dt>
            <dd>{profile?.state ?? "—"}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">US House district</dt>
            <dd>{profile?.congressionalDistrict ?? "—"}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-rule pt-2">
            <dt class="text-ink-muted">State legislative</dt>
            <dd>
              Lower {profile?.stateLegislativeLowerDistrict ?? "—"} · Upper {profile?.stateLegislativeUpperDistrict ?? "—"}
            </dd>
          </div>
        </dl>

        <div class="mt-8 border-t border-rule pt-4">
          <h3 class="text-sm font-semibold">Delete account</h3>
          <p class="mt-1 text-xs leading-relaxed text-ink-muted">
            Permanently deletes your account and everything tied to it — your ZIP, district, cached representatives, and action log. It happens immediately and cannot be undone.
          </p>
          <button
            type="button"
            id="delete-account"
            class="btn btn-ghost mt-3 text-coral-deep disabled:opacity-50"
          >
            Delete my account
          </button>
          <p id="delete-status" class="mt-2 text-sm" role="status"></p>
        </div>
      </section>
    </div>
  </section>

  <script is:inline type="module">
    const form = document.getElementById("zip-form");
    const status = document.getElementById("zip-status");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const zip = new FormData(form).get("zip");
      status.textContent = "Looking up...";
      status.className = "text-sm text-ink-muted";
      const res = await fetch("/api/reps/lookup", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ zip }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = data.message || data.error || "Lookup failed.";
        status.className = "text-sm text-coral-deep";
        return;
      }
      status.textContent = `Saved. Found ${data.representatives?.length ?? 0} representatives. Reloading...`;
      status.className = "text-sm text-leaf";
      setTimeout(() => location.reload(), 700);
    });
  </script>

  <script>
    import { signOut } from "~/lib/auth-client";

    const btn = document.getElementById("delete-account") as HTMLButtonElement | null;
    const status = document.getElementById("delete-status");

    if (btn) {
      btn.addEventListener("click", async () => {
        const ok = window.confirm(
          "This permanently deletes your account and all your data — your ZIP, " +
            "district, cached representatives, and action log. It cannot be undone.\n\n" +
            "Delete your account?",
        );
        if (!ok) return;

        btn.disabled = true;
        if (status) {
          status.textContent = "Deleting your account…";
          status.className = "mt-2 text-sm text-ink-muted";
        }

        let res: Response | null = null;
        try {
          res = await fetch("/api/me/delete", { method: "POST" });
        } catch {
          res = null;
        }

        if (!res || !res.ok) {
          btn.disabled = false;
          if (status) {
            status.textContent =
              "Couldn't delete your account — please try again, or email privacy@americansforpropriety.org.";
            status.className = "mt-2 text-sm text-coral-deep";
          }
          return;
        }

        if (status) {
          status.textContent = "Account deleted. Signing you out…";
          status.className = "mt-2 text-sm text-leaf";
        }
        // The account row is gone server-side; clear the dead session cookie and leave.
        try {
          await signOut();
        } catch {
          /* session already removed — nothing left to clear */
        }
        window.location.href = "/";
      });
    }
  </script>
</BaseLayout>
