---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import PostCard from "~/components/PostCard.astro";
import Hero from "~/components/Hero.astro";
import SearchFilter from "~/components/SearchFilter.astro";
import { getSupabase } from "~/lib/supabase";
import { getEnv, isSupabaseConfigured } from "~/lib/env";
import { getIssueLabels } from "~/lib/issue-labels";
import { issueOrder } from "~/config/site";

export const prerender = false;

const issueLabels = await getIssueLabels();

// Static (curated) briefs from the content collection.
const staticBriefs = (await getCollection("briefs", ({ data }) => !data.draft))
  .map((b) => ({
    href: `/briefs/${b.id}`,
    eyebrow: `Brief · ${(issueLabels[b.data.issue] ?? b.data.issue.replace(/-/g, " "))}`,
    title: b.data.title,
    summary: b.data.summary,
    date: b.data.publishedAt,
    issue: b.data.issue,
    source: "static" as const,
  }));

// AI-drafted briefs from Supabase (published only). Skip if not configured.
let aiBriefs: Array<{
  href: string;
  eyebrow: string;
  title: string;
  summary: string;
  date: Date;
  issue: string;
  source: "ai";
}> = [];

if (isSupabaseConfigured(getEnv(Astro))) {
  const supabase = getSupabase(Astro);
  const { data: aiRows } = await supabase
    .from("ai_briefs")
    .select("slug, title, summary, issue, published_at")
    .eq("status", "published")
    .order("published_at", { ascending: false });

  aiBriefs = (aiRows ?? []).map((b: any) => ({
    href: `/briefs/${b.slug}`,
    eyebrow: `Weekly · ${(issueLabels[b.issue] ?? b.issue.replace(/-/g, " "))}`,
    title: b.title,
    summary: b.summary,
    date: new Date(b.published_at),
    issue: b.issue as string,
    source: "ai" as const,
  }));
}

const all = [...staticBriefs, ...aiBriefs].sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);

const issueCounts = all.reduce<Record<string, number>>((acc, b) => {
  acc[b.issue] = (acc[b.issue] ?? 0) + 1;
  return acc;
}, {});
const issueOptions = issueOrder
  .filter((slug) => issueCounts[slug])
  .map((slug) => ({
    value: slug,
    label: issueLabels[slug] ?? slug,
    count: issueCounts[slug],
  }));
---
<BaseLayout
  title="Briefs"
  description="Plain-language research on US public policy."
  ogImage="/hero/briefs-press-room.png"
>
  <Hero tone="warm" imageStyle="bleed">
    <p class="eyebrow">Research</p>
    <h1 class="mt-3 max-w-3xl text-balance">Briefs.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Short, sourced explanations of policy questions in front of US legislators. Curated long-form pieces and weekly news briefs on top political headlines.
    </p>
    <img
      slot="visual"
      src="/hero/briefs-press-room.png"
      alt="The White House press briefing room."
      class="h-full w-full object-cover"
      loading="eager"
    />
  </Hero>

  <Section>
    {all.length === 0 ? (
      <p>No briefs yet.</p>
    ) : (
      <SearchFilter
        scope="briefs"
        placeholder="Search briefs by title, topic, or keyword…"
        totalLabel="briefs"
        filters={[{ key: "issue", label: "Issue area", options: issueOptions }]}
      >
        <div>
          {all.map((b) => (
            <div
              data-card
              data-search={`${b.title} ${b.summary} ${issueLabels[b.issue] ?? ""} ${b.eyebrow}`.toLowerCase()}
              data-issue={b.issue}
            >
              <PostCard
                href={b.href}
                eyebrow={b.eyebrow}
                title={b.title}
                summary={b.summary}
                date={b.date}
              />
            </div>
          ))}
        </div>
      </SearchFilter>
    )}
  </Section>
</BaseLayout>
