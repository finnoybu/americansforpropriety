---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import SearchFilter from "~/components/SearchFilter.astro";
import { getIssueLabels } from "~/lib/issue-labels";
import { issueOrder } from "~/config/site";

const issueLabels = await getIssueLabels();

const letters = (await getCollection("letters")).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);

// Time-sensitive letters: deadline still ahead at build time, soonest first.
// The page is prerendered, so a small script below also hides any whose
// deadline passes between deploys.
const buildTime = Date.now();
const timeSensitive = letters
  .filter((l) => l.data.deadline && l.data.deadline.getTime() + 24 * 60 * 60 * 1000 >= buildTime)
  .sort((a, b) => a.data.deadline!.getTime() - b.data.deadline!.getTime());
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const issueCounts =letters.reduce<Record<string, number>>((acc, l) => {
  acc[l.data.issue] = (acc[l.data.issue] ?? 0) + 1;
  return acc;
}, {});
const issueOptions = issueOrder
  .filter((slug) => issueCounts[slug])
  .map((slug) => ({
    value: slug,
    label: issueLabels[slug] ?? slug,
    count: issueCounts[slug],
  }));

const audienceCounts = letters.reduce<Record<string, number>>((acc, l) => {
  acc[l.data.audience] = (acc[l.data.audience] ?? 0) + 1;
  return acc;
}, {});
const audienceOptions = Object.entries(audienceCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([label, count]) => ({
    value: label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
    label,
    count,
  }));
---
<BaseLayout
  title="Letters"
  description="Constituent letter templates with judgment built in."
  ogImage="/hero/letters-rotunda.png"
>
  <Hero tone="warm" imageStyle="bleed">
    <p class="eyebrow">Engage</p>
    <h1 class="mt-3 max-w-3xl text-balance">Letters constituents actually send.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Templates designed to be personalized — not blasted. Form letters get filtered. Personal letters, written by an actual constituent, get read.
    </p>
    <img
      slot="visual"
      src="/hero/letters-rotunda.png"
      alt="The U.S. Capitol Rotunda interior."
      class="h-full w-full object-cover object-bottom"
      loading="eager"
    />
  </Hero>

  {timeSensitive.length > 0 && (
    <Section>
      <div data-time-sensitive>
        <p class="eyebrow text-coral-deep">Time-sensitive</p>
        <h2 class="mt-2 text-2xl font-semibold">Send these first</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-muted">
          These letters are tied to a vote or deadline coming up soon. After the date passes they drop back into the full list below.
        </p>
        <ul class="mt-6 grid list-none gap-4 p-0 md:grid-cols-2">
          {timeSensitive.map((l) => (
            <li data-deadline={l.data.deadline!.toISOString()}>
              <a
                href={`/letters/${l.id}`}
                class="block h-full border-l-4 border-coral bg-paper-warm p-6 no-underline"
              >
                <p class="eyebrow">
                  Act by {fmtDate(l.data.deadline!)}
                  {l.data.deadlineLabel && <> · {l.data.deadlineLabel}</>}
                </p>
                <h3 class="mt-2 text-xl font-semibold leading-snug">{l.data.title}</h3>
                <p class="mt-2 text-sm text-ink-muted">{l.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Section>
  )}

  <Section>
    {letters.length === 0 ? (
      <p>No letters yet.</p>
    ) : (
      <SearchFilter
        scope="letters"
        placeholder="Search letters by title, topic, or recipient…"
        totalLabel="letters"
        filters={[
          { key: "issue", label: "Issue area", options: issueOptions },
          { key: "audience", label: "Audience", options: audienceOptions },
        ]}
      >
        <ul class="list-none p-0">
          {letters.map((l) => {
            const audienceSlug = l.data.audience
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-|-$/g, "");
            return (
              <li
                data-card
                data-search={`${l.data.title} ${l.data.summary} ${l.data.audience} ${issueLabels[l.data.issue] ?? ""}`.toLowerCase()}
                data-issue={l.data.issue}
                data-audience={audienceSlug}
              >
                <a href={`/letters/${l.id}`} class="block border-t border-rule py-6 no-underline">
                  <p class="eyebrow">{l.data.audience} · {issueLabels[l.data.issue] ?? l.data.issue.replace(/-/g, " ")}</p>
                  <h3 class="mt-2 text-xl font-semibold leading-snug">{l.data.title}</h3>
                  <p class="mt-2 max-w-2xl text-sm text-ink-muted">{l.data.summary}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </SearchFilter>
    )}
  </Section>

  <script>
    // Hide time-sensitive cards whose deadline passed since the last deploy.
    // A deadline counts through the end of that day (UTC).
    const box = document.querySelector("[data-time-sensitive]");
    if (box) {
      const now = Date.now();
      const cards = box.querySelectorAll<HTMLElement>("[data-deadline]");
      let visible = 0;
      cards.forEach((card) => {
        const end = new Date(card.dataset.deadline ?? "").getTime() + 24 * 60 * 60 * 1000;
        if (Number.isFinite(end) && end < now) card.hidden = true;
        else visible++;
      });
      if (visible === 0) (box.closest("section") ?? box).setAttribute("hidden", "");
    }
  </script>
</BaseLayout>
