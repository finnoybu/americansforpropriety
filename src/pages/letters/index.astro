---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";

const letters = (await getCollection("letters")).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);
---
<BaseLayout title="Letters" description="Constituent letter templates with judgment built in.">
  <Hero tone="warm" imageStyle="bleed">
    <p class="eyebrow">Engage</p>
    <h1 class="mt-3 max-w-3xl text-balance">Letters constituents actually send.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-soft)]">
      Templates designed to be personalized — not blasted. Form letters get filtered. Personal letters, written by an actual constituent, get read.
    </p>
    <img
      slot="visual"
      src="/hero/letters-rotunda.png"
      alt="The U.S. Capitol Rotunda interior."
      class="h-full w-full object-cover object-bottom"
      loading="eager"
    />
  </Hero>

  <Section>
    {letters.length === 0 && <p>No letters yet.</p>}
    <ul>
      {letters.map((l) => (
        <li>
          <a href={`/letters/${l.id}`} class="block border-t border-[color:var(--color-rule)] py-6 no-underline">
            <p class="eyebrow">{l.data.audience} · {l.data.issue.replace(/-/g, " ")}</p>
            <h3 class="mt-2 text-xl font-semibold leading-snug">{l.data.title}</h3>
            <p class="mt-2 max-w-2xl text-sm text-[color:var(--color-ink-muted)]">{l.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
