---
import type { HTMLAttributes } from "astro/types";
interface Props extends Omit<HTMLAttributes<"a">, "href" | "title"> {
  href: string;
  eyebrow: string;
  title: string;
  summary: string;
  accent?: "coral" | "gold" | "leaf" | "ink";
}
const { href, eyebrow, title, summary, accent = "coral", ...rest } = Astro.props;
const accentVar = {
  coral: "var(--color-coral)",
  gold: "var(--color-gold)",
  leaf: "var(--color-leaf)",
  ink: "var(--color-ink)",
}[accent];
---
<a href={href} {...rest} class="card-issue group no-underline" style={`--accent:${accentVar}`}>
  <span class="block h-1 w-10" style={`background:${accentVar}`}></span>
  <p class="eyebrow mt-4">{eyebrow}</p>
  <h3 class="mt-2 text-xl font-semibold leading-tight text-ink">
    {title}
  </h3>
  <p class="mt-3 grow text-sm leading-relaxed text-ink-muted">
    {summary}
  </p>
  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-ink group-hover:text-coral-deep">
    Read the issue <span aria-hidden>→</span>
  </span>
</a>
