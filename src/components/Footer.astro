---
import { site, nav } from "~/config/site";
const year = new Date().getFullYear();

const standardsLinks = [
  { href: "/principles", label: "Principles" },
  { href: "/editorial-standards", label: "Editorial standards" },
  { href: "/funding", label: "Funding & disclosures" },
  { href: "/corrections", label: "Corrections" },
  { href: "/accessibility", label: "Accessibility" },
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms of use" },
  { href: "/contact", label: "Contact" },
];

const engageLinks = [
  { href: "/take-action", label: "Take action" },
  { href: "/letters", label: "Letter templates" },
  { href: "/contribute", label: "Contribute on GitHub" },
  { href: "/rss.xml", label: "News RSS" },
];
---
<footer class="mt-24 border-t border-rule bg-paper-warm">
  <div class="container-page grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-4">
      <p class="font-display text-2xl font-semibold leading-tight text-ink">
        {site.name}
      </p>
      <p class="mt-2 max-w-md text-ink-soft">
        {site.tagline}
      </p>
      <p class="mt-6 max-w-md text-sm leading-relaxed text-ink-muted">
        A civic drafting and education project. We do not collect or store personal information from visitors. Members opt into a small toolkit and we tell them exactly what we keep.
      </p>
    </div>

    <div class="md:col-span-2">
      <p class="eyebrow">Site</p>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((item) => (
          <li><a class="no-underline hover:underline" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow">Engage</p>
      <ul class="mt-3 space-y-2 text-sm">
        {engageLinks.map((l) => (
          <li><a class="no-underline hover:underline" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow">Standards</p>
      <ul class="mt-3 space-y-2 text-sm">
        {standardsLinks.map((l) => (
          <li><a class="no-underline hover:underline" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-rule">
    <div class="container-page flex flex-col justify-between gap-3 py-5 text-xs text-ink-muted sm:flex-row sm:items-center">
      <p>© {year} {site.name}. Open civic infrastructure.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        <li><a class="no-underline hover:underline" href="/privacy">Privacy</a></li>
        <li><a class="no-underline hover:underline" href="/terms">Terms</a></li>
        <li><a class="no-underline hover:underline" href="/accessibility">Accessibility</a></li>
        <li><a class="no-underline hover:underline" href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>
