---
import { site, nav } from "~/config/site";
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-rule bg-paper-warm">
  <div class="container-page grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-display text-2xl font-semibold leading-tight text-ink">
        {site.name}
      </p>
      <p class="mt-2 max-w-md text-ink-soft">
        {site.tagline}
      </p>
      <p class="mt-6 max-w-md text-sm leading-relaxed text-ink-muted">
        A civic drafting and education project. We do not collect or store personal information from visitors.
      </p>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow">Site</p>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((item) => (
          <li><a class="no-underline hover:underline" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-4">
      <p class="eyebrow">Engage</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="no-underline hover:underline" href="/take-action">Take action</a></li>
        <li><a class="no-underline hover:underline" href="/principles">Principles</a></li>
        <li><a class="no-underline hover:underline" href="/rss.xml">News RSS</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-rule">
    <div class="container-page flex flex-col justify-between gap-2 py-5 text-xs text-ink-muted sm:flex-row sm:items-center">
      <p>© {year} {site.name}. Open civic infrastructure.</p>
      <p>Built in the open. No tracking. No data harvesting.</p>
    </div>
  </div>
</footer>
