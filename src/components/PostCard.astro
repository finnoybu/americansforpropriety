---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  summary: string;
  date: Date;
}
const { href, eyebrow, title, summary, date } = Astro.props;
const dateLabel = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---
<a href={href} class="group block border-t border-rule py-6 no-underline">
  <div class="flex items-baseline justify-between gap-4">
    <p class="eyebrow">{eyebrow}</p>
    <time class="text-xs text-ink-muted">{dateLabel}</time>
  </div>
  <h3 class="mt-2 text-xl font-semibold leading-snug text-ink group-hover:text-coral-deep">
    {title}
  </h3>
  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">
    {summary}
  </p>
</a>
