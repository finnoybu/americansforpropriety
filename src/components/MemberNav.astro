---
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + "/");
const items = [
  { href: "/member", label: "Dashboard" },
  { href: "/member/representatives", label: "My representatives" },
  { href: "/letters", label: "Letter templates" },
  { href: "/member/actions", label: "Action log" },
  { href: "/member/setup", label: "Settings" },
];
---
<nav aria-label="Member" class="rule-top mb-8 flex flex-wrap gap-x-6 gap-y-2 pt-4 text-sm">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={[
        "no-underline",
        isActive(item.href)
          ? "font-semibold text-coral-deep"
          : "text-ink-muted hover:text-ink",
      ]}
      aria-current={isActive(item.href) ? "page" : undefined}
    >
      {item.label}
    </a>
  ))}
  <button
    type="button"
    data-signout
    class="ml-auto text-sm text-ink-muted underline hover:text-coral-deep"
  >
    Sign out
  </button>
</nav>

<script>
  import { signOut } from "~/lib/auth-client";

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-signout]")) {
    btn.addEventListener("click", async () => {
      await signOut();
      window.location.href = "/";
    });
  }
</script>
