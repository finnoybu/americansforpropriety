---
interface Props {
  title?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = "Civic restraint takes work.",
  body = "Use a letter template. Read a brief. Send something to a legislator that sounds like you, not a campaign blast.",
  ctaLabel = "Take action",
  ctaHref = "/take-action",
} = Astro.props;
---
<aside class="bg-ink text-paper">
  <div class="container-page grid items-center gap-6 py-14 md:grid-cols-12 md:py-20">
    <div class="md:col-span-8">
      <p class="eyebrow text-gold-soft">Get involved</p>
      <h2 class="mt-2 text-paper">{title}</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-paper-warm">{body}</p>
    </div>
    <div class="md:col-span-4 md:justify-self-end">
      <a href={ctaHref} class="btn btn-primary text-base">{ctaLabel} <span aria-hidden>→</span></a>
    </div>
  </div>
</aside>
