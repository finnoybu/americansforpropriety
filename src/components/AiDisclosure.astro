---
// Disclosure shown on letters and posts with `aiDrafted: true`.
// Policy: /editorial-standards#ai
interface Props {
  kind: "letter template" | "post";
}
const { kind } = Astro.props;
---
<aside class="mt-6 max-w-3xl border border-rule bg-paper-warm px-4 py-3 text-sm leading-relaxed text-ink-muted" data-ai-disclosure>
  <strong class="text-ink">Drafted by AI.</strong>
  This {kind} was researched and written by an AI system and checked by separate AI review agents before publishing. It was not reviewed by a person before it went live.
  <a href="/editorial-standards/#ai" class="underline">How this works</a> ·
  <a href="/corrections/" class="underline">Report an error</a>
</aside>
